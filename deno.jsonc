{
	"lock": false,
	"tasks": {
		"cli": "deno run -RN src/cli.ts",
		"build": "deno run -RWN src/_updateAllDataFiles.ts",
		"update-commit-hashes": "deno run -A src/_updateUnicodeCommitHashes.ts",
		"test": "deno test -A",
		"write-data": "deno run -RWN src/writeData.ts"
	},
	"name": "@li/unicode-names",
	"version": "0.0.6",
	"exports": {
		".": "./src/mod.ts",
		"./cli": "./src/cli.ts",
		"./write-data": "./src/writeData.ts"
	},
	"imports": {
		"@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.5",
		"@cliffy/keycode": "jsr:@cliffy/keycode@1.0.0-rc.7",
		"@cliffy/keypress": "jsr:@cliffy/keypress@1.0.0-rc.7",
		"@cliffy/prompt": "jsr:@cliffy/prompt@1.0.0-rc.7",
		"@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.7",
		"@li/regexp-escape-polyfill": "jsr:@li/regexp-escape-polyfill@^0.3.4",
		"@li/unicode-names": "./src/mod.ts",
		"@std/assert": "jsr:@std/assert@^1.0.3",
		"@std/fmt": "jsr:@std/fmt@^1.0.3",
		"@std/fs": "jsr:@std/fs@^1.0.2",
		"@std/path": "jsr:@std/path@^1.0.3"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": ["README.md"]
	}
}
